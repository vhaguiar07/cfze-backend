generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id                     String    @id @default(uuid()) @db.Uuid
  fullName               String
  address                String
  city                   String
  postalCode             String
  phoneNumber            String
  nationality            String
  cpf                    String    @unique
  rg                     String    @unique
  rgIssueDate            DateTime?
  rgIssuingAgency        String?
  rgState                String?
  ctps                   String    @unique
  pisPasep               String    @unique
  educationLevel         String
  voterRegistration      String?   @unique
  reservist              String?   @unique
  fatherName             String?
  motherName             String?
  maritalStatus          String?
  sex                    String
  birthDate              DateTime
  birthPlace             String?
  admissionDate          DateTime
  salary                 Decimal
  jobTitle               String
  department             String?
  monthlyWorkloadHours   Int
  weeklyWorkloadHours    Int
  dayOff                 String?
  transportDiscount      Boolean

  // Work Schedule - Weekdays
  firstEntryWeekday      String?
  firstExitWeekday       String?
  secondEntryWeekday     String?
  secondExitWeekday      String?

  // Work Schedule - Weekends
  firstEntryWeekend      String?
  firstExitWeekend       String?
  secondEntryWeekend     String?
  secondExitWeekend      String?

  // PPE (Personal Protective Equipment)
  receivedPPE            Boolean
  pantsSize              String?
  shirtSize              String?
  bootSize               String?
  jacketSize             String?
  balaclavaSize          String?
  gogglesSize            String?
  glovesSize             String?
  ppeReceiptDate         DateTime?

  // Vacation and Termination
  tookVacation           Boolean
  vacationDate           DateTime?
  terminationType        String?  // Options: 'Fired', 'Resigned', 'Just Cause'
  terminationDate        DateTime?
  receivedIndemnity      Boolean?
  indemnityDate          DateTime?
  indemnityValue         Decimal?

  // Interview Information
  admissionInterview     Boolean?
  exitInterview          Boolean?

  // Medical Examinations
  admissionAsoDates      DateTime[] @default([])
  periodicAsoDates       DateTime[] @default([])
  dismissalAsoDates      DateTime[] @default([])

  // Leave and Accident Records
  paternityLeaveDates    DateTime[] @default([])
  maternityLeaveDates    DateTime[] @default([])
  electoralLeaveDates    DateTime[] @default([])
  sufferedAccident       Boolean?
  leaveOfAbsenceDates    DateTime[] @default([])

  // Relations
  companyId              String    @db.Uuid
  company                Company   @relation(fields: [companyId], references: [id])
  employeeBenefits       EmployeeBenefit[]
  attendanceRecords      EmployeeAttendance[]
  incidentRecords        IncidentRecord[]
  accidentControls       AccidentControl[]
  ppeControls            EmployeePPEControl[]

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  deletedAt              DateTime?
}

model Company {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  cnpj              String   @unique
  employees         Employee[]
  employeeBenefits  EmployeeBenefit[]
  attendanceRecords EmployeeAttendance[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
}

model IncidentRecord {
  id                    String   @id @default(uuid()) @db.Uuid
  employeeId            String   @db.Uuid
  employee              Employee @relation(fields: [employeeId], references: [id])

  month                 String
  accidentsWithLeave    Boolean
  accidentOrIncident    String  // 'Accident' or 'Incident'
  injurySeverity        String  // e.g., 'Mild', 'Moderate', 'Severe'

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AccidentControl {
  id                    String   @id @default(uuid()) @db.Uuid
  employeeId            String   @db.Uuid
  employee              Employee @relation(fields: [employeeId], references: [id])

  accidentNumber        String  @unique  // Número da CAT
  accidentDate          DateTime
  birthDate             DateTime
  sex                   String
  jobTitle              String
  accidentType          String  // e.g., 'Queda', 'Corte', 'Impacto'
  accidentDescription   String
  accidentsWithLeave    Boolean
  bodyPartAffected      String
  injurySeverity        String  // e.g., 'Mild', 'Moderate', 'Severe'
  accidentOrIncident    String  // 'Accident' or 'Incident'
  medicalCertificates   Int
  daysAway              Int?
  hoursAway             Int?

  comments              String?

  // Relação com AccidentCost
  accidentCost          AccidentCost?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AccidentCost {
  id                    String   @id @default(uuid()) @db.Uuid
  accidentId            String   @unique @db.Uuid
  accident              AccidentControl @relation(fields: [accidentId], references: [id])

  medicationCost        Decimal  @default(0.0)
  foodCost              Decimal  @default(0.0)
  materialCost          Decimal  @default(0.0)
  legalCost             Decimal  @default(0.0)
  totalCost             Decimal  @default(0.0)

  comments              String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model EmployeeBenefit {
  id                        String   @id @default(uuid()) @db.Uuid
  employeeId                String   @db.Uuid
  employee                  Employee @relation(fields: [employeeId], references: [id])
  companyId                 String   @db.Uuid
  company                   Company  @relation(fields: [companyId], references: [id])

  benefit                   String
  referencePeriod           String
  type                      String
  area                      String?
  jobTitle                  String
  mealVoucherPrice          Decimal
  workDays                  Int
  extraDays                 Int
  justifiedAbsenceDays      Int
  paidDays                  Int
  totalPrice                Decimal
  comments                  String?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model EmployeeAttendance {
  id                        String   @id @default(uuid()) @db.Uuid
  employeeId                String   @db.Uuid
  employee                  Employee @relation(fields: [employeeId], references: [id])
  companyId                 String   @db.Uuid
  company                   Company  @relation(fields: [companyId], references: [id])

  area                      String?
  jobTitle                  String
  referencePeriod           String  // Exemplo: "Janeiro/2025"
  absenceDescription        String? // Exemplo: "Falta Justificada"
  situation                 String  // Exemplo: "Atestado Médico"

  workDays                  Int     // Quantidade de dias úteis
  absences                  Int     // Quantidade de faltas
  medicalLeaveDays          Int     // Quantidade de dias de atestado médico
  extraDays                 Int     // Quantidade de dias extras
  justifiedAbsenceDays      Int     // Quantidade de dias abonados
  workedDays                Int     // Quantidade de dias trabalhados

  date                      DateTime // Data do registro
  comments                  String?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model EmployeePPEControl {
  id                      String   @id @default(uuid()) @db.Uuid
  employeeId              String   @db.Uuid
  employee                Employee @relation(fields: [employeeId], references: [id])

  ppeDescription          String   // Descrição do EPI
  department              String   // Setor do funcionário
  referenceMonth          String   // Mês de referência (exemplo: "Janeiro")
  situation               String   // Situação (exemplo: "Troca do EPI", "Aquisição", "Saída")
  quantity                Int      // Quantidade de EPIs fornecidos ou trocados
  reasonForReplacement    String?  // Motivo da troca do EPI
  comments                String?  // Comentários adicionais

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
